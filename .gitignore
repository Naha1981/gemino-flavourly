# Dependencies
node_modules
.pnp
.pnp.js

# Testing
/coverage
/test-results
/playwright-report
/blob-report
# Seeded E2E state (session ids / claim tokens) — never commit.
.e2e-state.json

# Next.js build output
.next/
out/

# Operator build output
dist/
/operator/dist

# Production
build
# ...but the magic-link / admin API route is named "build" as a Next.js
# route segment (not a build output), so re-include that exact path.
# The [id] brackets are gitignore globs, so they must be escaped.
!apps/main/app/api/prospects/\[id\]/build/
!apps/main/app/api/prospects/\[id\]/build/**

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment files - NEVER COMMIT SECRETS
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
apps/main/.env
apps/main/.env.local
operator/.env
operator/.env.local

# Vercel & Turbo
.vercel
.turbo

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# One-shot dev tools (may contain secrets).
# NOTE: scripts/setup-cronjobs.mjs is now canonical (S5) — it reads all
# credentials from env and the fleet from scripts/cron-fleet.json, so it is
# tracked in git. Only ad-hoc cleanup tools stay ignored.
scripts/clean-cronjobs.mjs
cron-cleanup.sh
existing_jobs.json

# Agent tooling (Neon CLI skills install; local-only, never shipped)
.claude/
skills-lock.json
