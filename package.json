{
  "name": "gemino-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant WhatsApp AI SaaS Platform (Direct Baileys Architecture)",
  "workspaces": [
    "apps/*",
    "operator"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "npm run test:main && npm run test:operator",
    "test:main": "node --test \"apps/main/lib/**/*.test.ts\"",
    "test:operator": "npm run build --workspace=gemino-operator && node --test \"operator/test/**/*.test.ts\"",
    "db:generate": "cd apps/main && npx drizzle-kit generate",
    "db:migrate": "cd apps/main && drizzle-kit migrate",
    "db:deploy": "cd apps/main && drizzle-kit migrate",
    "db:studio": "cd apps/main && npx drizzle-kit studio",
    "operator:dev": "cd operator && npm run dev",
    "operator:build": "cd operator && npm run build",
    "operator:start": "cd operator && npm start",
    "test:e2e": "playwright test",
    "synthetic:smoke": "node synthetic-testing/runner/matraix-runner.mjs user_signs_up_and_onboards",
    "synthetic:landing": "node synthetic-testing/runner/matraix-runner.mjs landing_page_engagement",
    "synthetic:all": "node synthetic-testing/runner/matraix-runner.mjs landing_page_engagement && node synthetic-testing/runner/matraix-runner.mjs user_signs_up_and_onboards",
    "test:e2e:seed": "node e2e/ship-seed.mjs",
    "fleet:snapshot": "node scripts/gen-fleet-snapshot.mjs",
    "ship:ops": "node scripts/ship-ops.mjs",
    "test:e2e:ship": "playwright test e2e/ship.spec.ts"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.21.0",
    "@playwright/test": "^1.48.0",
    "drizzle-kit": "^0.24.0",
    "turbo": "^2.10.11",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=20.0.0"
  }
}