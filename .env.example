# ==============================================================================
# Gemino-Flavourly environment contract
# ==============================================================================
# Placeholder values only. Never commit production credentials.

# ------------------------------- MAIN APP ------------------------------------
DATABASE_URL="postgresql://username:password@host.region.aws.neon.tech/neondb?sslmode=require"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"
CRON_SECRET="generate-a-strong-random-secret"
ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_EMAILS="another-admin@yourdomain.com"

# ------------------------- CENTRAL WHATSAPP OPERATOR --------------------------
# The ONLY WhatsApp transport used by Gemino.
OPERATOR_URL="https://my-own-whatsapp-2z5h.onrender.com"
OPERATOR_API_KEY="generate-a-strong-operator-key"
WEBHOOK_SECRET="generate-a-strong-webhook-hmac-secret"
APP_ID="gemino"
APP_URL="https://gemino-flavourly-whatsapp.vercel.app"
NEXT_PUBLIC_WHATSAPP_CONTACT="27820000000"

# --------------------------- AUTPOST / OPENPOST -------------------------------
# Optional publishing execution layer. Flavourly remains the revenue/guest
# brain; OpenPost handles connected social accounts, scheduling and publishing.
OPENPOST_BASE_URL="https://your-openpost-host.example"
OPENPOST_API_TOKEN="your-openpost-api-token"
OPENPOST_TIMEOUT_MS="30000"

# -------------------------------- AI -----------------------------------------
GROQ_API_KEY="gsk_..."
GOOGLE_GEMINI_API_KEY="AIzaSy..."

# ----------------------------- GOOGLE ----------------------------------------
GOOGLE_PLACES_API_KEY="AIzaSy..."
GOOGLE_MAPS_API_KEY="AIzaSy..."

# ------------------------------ BILLING --------------------------------------
NEXT_PUBLIC_APP_URL="https://gemino-flavourly-whatsapp.vercel.app"
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="your-merchant-key"
PAYFAST_PASSPHRASE="your-passphrase"
PAYFAST_SANDBOX="true"

# [DEV ONLY] Permit unsigned local webhook replay when WEBHOOK_SECRET is unset.
# Never enable this in production.
# ALLOW_UNSIGNED_WEBHOOKS="true"

# ----------------------------- QA / ALERTING ----------------------------------
RESEND_API_KEY="re_..."
QA_ALERT_TO="naha.thabiso@gmail.com"
QA_ALERT_FROM="Flavourly QA <onboarding@resend.dev>"
CRONJOB_API_KEY="your-cron-job-org-account-api-key"

