# ==============================================================================
# ENVIRONMENT CONTRACT
# ==============================================================================
# This file is the authoritative list of environment variables this repository
# actually reads. It was reconciled against the code on 2026-08-23: every
# variable below is referenced somewhere in apps/main or operator (or is read
# by a dependency, where noted), and every variable read by the code appears
# below.
#
# PLACEHOLDER VALUES ONLY. Never commit a real credential to this file.
#
# Legend:
#   [REQUIRED]  the service will not work (or will not start) without it
#   [OPTIONAL]  has a safe default, or enables a non-essential feature
#   [DEV ONLY]  must never be set in a production deployment
# ==============================================================================


# ==============================================================================
# MAIN APP (Vercel Serverless)
# ==============================================================================

# [REQUIRED] Database connection (Neon Postgres or standard PostgreSQL).
# apps/main/lib/db/index.ts throws at import time if this is unset, which means
# every route fails — so a missing value is loud rather than silent.
DATABASE_URL="postgresql://username:password@ep-sample-host.region.aws.neon.tech/neondb?sslmode=require"

# [REQUIRED] Clerk authentication. These are not referenced by our own code:
# they are read directly by the @clerk/nextjs SDK, so they must still be set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# [OPTIONAL] Clerk redirect overrides, also consumed by the Clerk SDK.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# [REQUIRED for cron] Shared secret for the scheduled endpoints
# (/api/cron/outbox, /api/cron/waitlist, /api/cron/daily-brief).
#
# As of G0.1 this is MANDATORY, not optional: apps/main/lib/cron/authorize.ts
# fails CLOSED, so if this is unset every cron endpoint returns 401 and the
# outbox, waitlist and daily-brief jobs silently stop running.
#
# The scheduler must send it as an Authorization header:
#     Authorization: Bearer <CRON_SECRET>
# Query-string authentication (?key=, ?secret=) is NOT accepted — query
# strings leak into CDN, proxy and platform access logs.
CRON_SECRET="generate-a-strong-random-secret"

# [REQUIRED] Platform Super Admin allowlist. Grants access to the Super Admin
# dashboard, the global AI kill switch, and GET /api/migrate (which runs schema
# DDL against production). Both variables are read by
# apps/main/lib/auth/is-super-admin.ts and both accept a comma-separated list;
# they are merged, so either one (or both) may be used.
#
# Treat these as a security control: anyone whose Clerk account email appears
# here holds full platform-wide privileges.
ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_EMAILS="another-admin@yourdomain.com"

# [REQUIRED] WhatsApp Operator connection (the Render/Docker host).
# THE REAL SERVICE is gemino-flavourly-whatsapp.onrender.com. The old
# placeholder (gemino-operator.onrender.com) does NOT exist: copying it
# into Vercel makes every /connect kick fail as "engine unreachable
# (host: gemino-operator.onrender.com)" — the self-diagnosing error
# documented in docs/gate-reports/2026-08-31-gate-qr-and-demo.md.
OPERATOR_URL="https://gemino-flavourly-whatsapp.onrender.com"
OPERATOR_API_KEY="generate-a-strong-32-char-random-secret-key"

# [REQUIRED] Inbound webhook verification secret. Must be IDENTICAL to the
# operator's WEBHOOK_SECRET — the operator signs each forwarded message with
# HMAC-SHA256 and the main app verifies that signature.
WEBHOOK_SECRET="generate-another-strong-hmac-sha256-secret"

# [REQUIRED for AI replies] At least one of these must be set, or the AI
# responder cannot run (apps/main/lib/ai/responder.ts falls back through Groq
# then Gemini, and logs an error if neither is configured).
GROQ_API_KEY="gsk_..."
GOOGLE_GEMINI_API_KEY="AIzaSy..."

# [OPTIONAL] Public WhatsApp contact number (with country code, no +).
# Used for the "Contact us on WhatsApp" buttons on the landing and pricing pages.
NEXT_PUBLIC_WHATSAPP_CONTACT="27820000000"

# [REQUIRED for billing] Public URL of this app. Used for PayFast notify_url.
# Must match the actual deployment URL — PayFast ITNs are POSTed here.
NEXT_PUBLIC_APP_URL="https://gemino-flavourly-whatsapp.vercel.app"

# [REQUIRED for billing] PayFast merchant credentials (South Africa).
# PayFast handles tokenized recurring billing in ZAR. The billing gate and
# all automated messaging are paused until a tenant starts a paid subscription
# (or is within their 14-day trial). Set PAYFAST_SANDBOX="true" for testing.
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="your-merchant-key"
PAYFAST_PASSPHRASE="your-passphrase"
PAYFAST_SANDBOX="true"

# [DEV ONLY] Skips inbound webhook signature verification.

# [OPTIONAL] Google Maps Platform key(s) for the Reputation and Market
# Intelligence engines. The same key can serve all of them if the project has
# both APIs enabled; they are read separately so each can be scoped/limited
# independently in the Google Cloud console.
#
#   GOOGLE_PLACES_API_KEY  Places API (New) — review pulls
#                          (lib/reputation/google-places-client.ts) and
#                          competitor discovery via Nearby Search
#                          (lib/market/geolocation.ts)
#   GOOGLE_MAPS_API_KEY    Geocoding API — turns the tenant's street address
#                          into the point the 5km competitor search is
#                          centred on. Falls back to GOOGLE_PLACES_API_KEY
#                          when unset.
#
# Without them: reviews are not pulled, competitor discovery returns a clear
# error, and menu/promotion tracking still works (it scrapes public websites
# and needs no Google key at all).
GOOGLE_PLACES_API_KEY="AIzaSy..."
GOOGLE_MAPS_API_KEY="AIzaSy..."

# [DEV ONLY] Skips inbound webhook signature verification.
#
# Set to exactly "true" to allow UNSIGNED webhook requests during local
# development — useful for replaying a payload with curl without computing an
# HMAC. It only applies when WEBHOOK_SECRET is NOT set; if a secret is
# configured, signatures are always verified regardless of this flag.
#
# It CANNOT weaken production. apps/main/lib/webhook/verify.ts hard-disables
# this escape hatch whenever NODE_ENV=production or VERCEL_ENV=production, so
# setting it on a production deployment has no effect whatsoever. Any value
# other than the exact string "true" is ignored.
#
# Leave this unset (commented out) unless you are actively debugging locally.
# ALLOW_UNSIGNED_WEBHOOKS="true"


# ==============================================================================
# OPERATOR (Render / Docker persistent service)
# ==============================================================================
# The operator validates its configuration at boot (operator/src/config.ts).
# If any REQUIRED variable below is missing or blank it logs the variable NAME
# (never the value) and exits non-zero BEFORE binding its port, so a
# misconfigured deploy fails visibly instead of running as a healthy-looking
# service that silently drops every inbound WhatsApp message.

# [REQUIRED] Same Postgres database as the main app.
# DATABASE_URL=...  (see above — the operator reads the same variable)

# [REQUIRED] Must match the main app's WEBHOOK_SECRET exactly.
# WEBHOOK_SECRET=...  (see above)

# [REQUIRED] Must match the main app's OPERATOR_API_KEY exactly. The operator
# requires it as an `x-api-key` header on /start, /send and /status.
# OPERATOR_API_KEY=...  (see above)

# [OPTIONAL] Where the operator POSTs inbound WhatsApp messages.
#
# Defaults to http://localhost:3000/api/webhooks/whatsapp, which is correct for
# local development but WRONG in production: if this is not set on Render, every
# inbound message is posted to the operator's own localhost and is lost, with no
# error surfaced to the main app. Set it explicitly in any deployed environment.
#
# A per-account webhook_url binding in the database takes precedence over this.
MAIN_APP_WEBHOOK_URL="https://gemino.yourdomain.com/api/webhooks/whatsapp"

# [OPTIONAL] HTTP port the operator listens on. Defaults to 3001. Render sets
# this automatically.
PORT=3001

# [OPTIONAL] pino log level: trace | debug | info | warn | error | fatal.
# Defaults to "info".
LOG_LEVEL="info"


# ==============================================================================
# GATE QA-2 — SELF-TESTING APP + FAILURE ALERTS (2026-09)
# ==============================================================================
# The app tests itself: a 10-minute smoke sweep (GET /api/cron/qa-sweep,
# scheduled on cron-job.org) + a 6-hourly Playwright persona run (GitHub
# Actions). Any failure emails the owner AND lands in the Super Admin
# portal's QA Failure Alerts panel (unread badge), deduped to once per 6h
# per failing check.

# [OPTIONAL but recommended] Resend API key for the alert email leg.
# Without it the pipeline still writes admin_notifications rows (the portal
# badge is the fallback channel); email dispatch is then recorded as
# skipped_no_key. Get a key at https://resend.com — the free tier covers
# these low-volume alarm emails.
RESEND_API_KEY="re_..."

# [OPTIONAL] Alert email destination. Defaults to the owner's address
# (lib/qa/alert-policy.ts QA_ALERT_DEFAULT_TO).
QA_ALERT_TO="naha.thabiso@gmail.com"

# [OPTIONAL] Alert email sender. Defaults to Resend's shared test sender;
# once a custom domain is verified in Resend, set e.g.
# "Flavourly QA <qa@yourdomain.com>".
QA_ALERT_FROM="Flavourly QA <onboarding@resend.dev>"

# [DEV ONLY] Forces the alert email leg into a no-network mock ("mock-sent")
# so the failing-first tests can assert the email path without a Resend key.
# Never set this in production — the real Resend transport requires
# RESEND_API_KEY, and this flag would silently swallow the emails.
# QA_ALERT_EMAIL_TRANSPORT="mock"

# [OPTIONAL] cron-job.org API key (env fallback). The preferred home is the
# encrypted system_settings value saved from /admin → Cron Fleet Manager;
# this env var is the fallback for fresh environments before that UI save.
# Used by the system watchdog (fleet auto-heal) and the qa-sweep fleet check.
CRONJOB_API_KEY="your-cron-job-org-account-api-key"

# [CI ONLY] Owner-provided credentials for the scheduled production persona
# run (GitHub Actions secrets, NEVER committed): the QA account must have
# password sign-in enabled in Clerk. The production run is READ-ONLY —
# persona writes only ever target the GATE_MOCK in-memory QA database.
# QA_EMAIL="qa-account@example.com"
# QA_PASSWORD="..."

# [GATE-MOCK ONLY] Local harness variables (see scripts/qa2-evidence-run.sh
# and tests/e2e/personas/). GATE_MOCK=1 swaps Clerk+Neon for the in-memory
# identity provider + pg-mem database; OPERATOR_URL then points at the local
# mock operator so the QR lifecycle can be asserted end-to-end.
