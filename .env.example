# ==============================================================================
# MAIN APP (Vercel Serverless) ENVIRONMENT VARIABLES
# ==============================================================================

# Database Connection (Neon Postgres Serverless or standard PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-host.region.aws.neon.tech/neondb?sslmode=require"

# Clerk Authentication (Get these from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Platform Super Admin Configuration
ADMIN_EMAIL="admin@yourdomain.com"

# WhatsApp Operator Connection (The Render/Docker Host)
OPERATOR_URL="https://gemino-operator.onrender.com"
OPERATOR_API_KEY="generate-a-strong-32-char-random-secret-key"

# Inbound Webhook Verification Secret (Must match between Operator and Main App)
WEBHOOK_SECRET="generate-another-strong-hmac-sha256-secret"

# AI Engine API Keys
GROQ_API_KEY="gsk_..."
GOOGLE_GEMINI_API_KEY="AIzaSy..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# App Public URL
NEXT_PUBLIC_APP_URL="https://gemino.yourdomain.com"
CRON_SECRET="optional-vercel-cron-authorization-secret"

# ==============================================================================
# OPERATOR (Render/Docker Persistent Service) ENVIRONMENT VARIABLES
# ==============================================================================
PORT=3001
LOG_LEVEL="info"
# Operator uses the same DATABASE_URL, OPERATOR_API_KEY, and WEBHOOK_SECRET above
